{
  "name": "@local/status-badge",
  "version": "1.4.3",
  "private": true,
  "type": "module",
  "description": "Shows what the agent is doing right now under the composer, with a round status light.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "window.html",
    "toast.html",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jims5115s-maker/dsh-status-badge.git"
  },
  "license": "MIT"
}
